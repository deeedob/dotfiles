{
  "custom/launcher": {
    "format": " ",
    "on-click": "wofi --show drun",
    "tooltip": false
  },
  "custom/seperator": {
    "format": "<span color='#8D8A7C'>|</span>",
    "tooltip": false
  },

  "custom/quit": {
    "format": "󰗼",
    "tooltip": false,
    "on-click": "loginctl terminate-user $USER"
  },
  "custom/lock": {
      "format": "󰍁",
      "tooltip": false,
      "on-click": "pidof hyprlock || hyprlock --immediate"
  },
  "custom/reboot": {
      "format": "󰜉",
      "tooltip": false,
      "on-click": "reboot"
  },
  "custom/power": {
      "format": "",
      "tooltip": false,
      "on-click": "shutdown now"
  },
  "custom/crypto": {
    "format": "{}",
    "interval": 600,
    "return-type": "json",
    "exec": "waybar-crypto",
    "exec-if": "ping pro-api.coinmarketcap.com -c1"
  }
}
