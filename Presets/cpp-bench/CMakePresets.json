{
  "version": 6,
  "configurePresets": [
    {
      "name": "release",
      "hidden": true,
      "generator": "Ninja",
      "displayName": "Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "COMPILE_WARNINGS_AS_ERRORS": "ON",
        "CMAKE_CXX_FLAGS": "-Wall -pedantic",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3"
      }
    },
    {
      "name": "release-gcc",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/release-gcc",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "release-clang",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/release-clang",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      }
    }
  ]
}
