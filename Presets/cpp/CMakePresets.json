{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "COMPILE_WARNINGS_AS_ERRORS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "gcc",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=lld"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },

    {
      "name": "asan",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=address -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer",
        "CMAKE_LINKER_FLAGS": "-fsanitize=address"
      }
    },
    {
      "name": "ubsan",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=undefined -fno-omit-frame-pointer",
        "CMAKE_LINKER_FLAGS": "-fsanitize=undefined"
      }
    },
    {
      "name": "tsan",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "msan",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=memory -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=memory -fno-omit-frame-pointer",
        "CMAKE_LINKER_FLAGS": "-fsanitize=memory"
      }
    },
    {
      "name": "coverage",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_FLAGS": "--coverage -fprofile-arcs -ftest-coverage",
        "CMAKE_CXX_FLAGS": "--coverage -fprofile-arcs -ftest-coverage"
      }
    },

    {
      "name": "gcc-debug",
      "inherits": ["gcc", "debug"],
      "description": "GCC Debug Build",
      "binaryDir": "${sourceDir}/build/gcc-debug",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "~/Libs/gcc-debug/"
      }
    },
    {
      "name": "gcc-release",
      "inherits": ["gcc", "release"],
      "description": "GCC Release Build",
      "binaryDir": "${sourceDir}/build/gcc-release",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "~/Libs/gcc-release/"
      }
    },

    {
      "name": "clang-debug",
      "inherits": ["clang", "debug"],
      "description": "Clang Debug Build",
      "binaryDir": "${sourceDir}/build/clang-debug",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "~/Libs/llvm/;~/Libs/clang-debug/"
      }
    },
    {
      "name": "clang-release",
      "inherits": ["clang", "release"],
      "description": "Clang Release Build",
      "binaryDir": "${sourceDir}/build/clang-release",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "~/Libs/llvm/;~/Libs/clang-release/"
      }
    }
  ]
}
