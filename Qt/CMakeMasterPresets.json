{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_COLOR_DIAGNOSTICS": true,
        "WARNINGS_ARE_ERRORS": false,
        "BUILD_SHARED_LIBS": true,

        "FEATURE_use_mold_linker": true,
        "FEATURE_developer_build": true,
        "FEATURE_processenvironment": true,
        "FEATURE_freetype": true,
        "FEATURE_harfbuzz": true,
        "FEATURE_fontconfig": true,
        "FEATURE_system_freetype": true,
        "FEATURE_system_harfbuzz": false,
        "FEATURE_system_sqlite": false,
        "FEATURE_system_zlib": false,
        "QLITEHTML_USE_SYSTEM_LITEHTML": false,

        "QT_UNITY_BUILD": false,
        "QT_UNITY_BUILD_BATCH_SIZE": "64",
        "QT_USE_CCACHE": true,

        "QT_BUILD_TESTS": false,
        "QT_BUILD_EXAMPLES": false,
        "QT_BUILD_BENCHMARKS": false,
        "QT_BUILD_MANUAL_TESTS": false,
        "QT_BUILD_TESTS_BY_DEFAULT": false,
        "QT_BUILD_EXAMPLES_BY_DEFAULT": false,
        "QT_BUILD_EXAMPLES_AS_EXTERNAL": false
      }
    },
    {
      "name": "gcc",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=lld",

        "QT_NO_FIND_PACKAGE_CLANG_WORKAROUND": true
      }
    },
    {
      "name": "aub_san",
      "hidden": true,
      "cacheVariables": {
        "FEATURE_sanitize_address": true,
        "FEATURE_sanitize_undefined": true
      }
    },

    {
      "name": "debug",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FEATURE_enable_gdb_index": true,
        "FEATURE_optimize_debug": true
      }
    },
    {
      "name": "release",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": true,
        "FEATURE_optimize_full": true
      }
    },

    {
      "name": "gcc-debug",
      "inherits": ["gcc", "debug"],
      "description": "GCC Debug Build",
      "binaryDir": "${sourceDir}/build/gcc-debug",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "~/Libs/gcc-debug/"
      }
    },
    {
      "name": "gcc-release",
      "inherits": ["gcc", "release"],
      "description": "GCC Release Build",
      "binaryDir": "${sourceDir}/build/gcc-release",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "~/Libs/gcc-release/"
      }
    },
    {
      "name": "gcc-debug-aub_san",
      "inherits": ["gcc", "debug", "aub_san"],
      "description": "GCC Debug Address+UB Sanitizer Build",
      "binaryDir": "${sourceDir}/build/gcc-debug-aub_san",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "~/Libs/gcc-debug-aub_san/"
      }
    },
    {
      "name": "gcc-static",
      "inherits": ["gcc", "release"],
      "description": "GCC Static Release Build",
      "binaryDir": "${sourceDir}/build/gcc-static",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "CMAKE_INSTALL_PREFIX": "~/Libs/qt-static",
        "CMAKE_PREFIX_PATH": "~/Libs/gcc-release/",
        "BUILD_SHARED_LIBS": false,
        "QT_BUILD_SUBMODULES": "qtbase;qtdeclarative;qtquick3d;qtshadertools;qtimageformats;qtsvg;qtgrpc;qtgraphs;qtwayland",
        "FEATURE_optimize_size": true,
        "FEATURE_developer_build": false,
        "FEATURE_testlib": false,
        "FEATURE_xml": false
      }
    },

    {
      "name": "clang-debug",
      "inherits": ["clang", "debug"],
      "description": "Clang Debug Build",
      "binaryDir": "${sourceDir}/build/clang-debug",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "~/Libs/llvm/;~/Libs/clang-debug/"
      }
    },
    {
      "name": "clang-release",
      "inherits": ["clang", "release"],
      "description": "Clang Release Build",
      "binaryDir": "${sourceDir}/build/clang-release",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "~/Libs/llvm/;~/Libs/clang-release/"
      }
    },
    {
      "name": "clang-debug-aub_san",
      "inherits": ["clang", "debug", "aub_san"],
      "description": "Clang Debug Address+UB Sanitizer Build",
      "binaryDir": "${sourceDir}/build/clang-debug-aub_san",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "~/Libs/llvm/;~/Libs/clang-debug-aub_san/"
      }
    },

    {
        "name": "android-arm64-v8a-debug",
        "inherits": ["base"],
        "description": "Android 64 bit arm Debug Build",
        "binaryDir": "${sourceDir}/build/android-arm64-v8a-debug",
        "cacheVariables": {
            "CMAKE_BUILD_TYPE": "Debug",
            "CMAKE_TOOLCHAIN_FILE": "~/Android/Sdk/ndk/28.0.13004108/build/cmake/android.toolchain.cmake",
            "ANDROID_ABI": "arm64-v8a",
            "ANDROID_SDK_ROOT": "/home/ddob/Android/Sdk",
            "QT_HOST_PATH": "~/Qt/qt6/build/gcc-debug/qtbase/",
            "OPENSSL_CRYPTO_LIBRARY": "~/Android/Sdk/android_openssl/ssl_3/arm64-v8a/libcrypto_3.so",
            "OPENSSL_SSL_LIBRARY": "~/Android/Sdk/android_openssl/ssl_3/arm64-v8a/libssl_3.so",
            "OPENSSL_INCLUDE_DIR": "~/Android/Sdk/android_openssl/ssl_3/arm64-v8a/include"
        }
    }
  ]
}
