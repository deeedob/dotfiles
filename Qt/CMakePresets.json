{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_COLOR_DIAGNOSTICS": true,
        "WARNINGS_ARE_ERRORS": true,

        "BUILD_SHARED_LIBS": true,
        "FEATURE_developer_build": true,

        "QT_UNITY_BUILD": false,
        "QT_UNITY_BUILD_BATCH_SIZE": "64",
        "QT_USE_CCACHE": true,

        "QT_BUILD_TESTS": true,
        "QT_BUILD_EXAMPLES": true,
        "QT_BUILD_BENCHMARKS": true,
        "QT_BUILD_MANUAL_TESTS": true,
        "QT_BUILD_TESTS_BY_DEFAULT": true,
        "QT_BUILD_EXAMPLES_BY_DEFAULT": true,
        "QT_BUILD_EXAMPLES_AS_EXTERNAL": false
      }
    },
    {
      "name": "gcc",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=lld"
      }
    },
    {
      "name": "asanub",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },

    {
      "name": "debug",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },

    {
      "name": "debug-gcc",
      "inherits": ["gcc", "debug"],
      "description": "GCC Debug Build",
      "binaryDir": "${sourceDir}/build/debug-gcc",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "~/Qt/qt6/build/debug-gcc/;~/Libs/debug-gcc/"
      }
    },
    {
      "name": "debug-asanub-gcc",
      "inherits": ["gcc", "debug", "asanub"],
      "description": "Clang Release Build",
      "binaryDir": "${sourceDir}/build/debug-asanub-clang",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "~/Qt/qt6/build/debug-asanub-gcc/;~/Libs/debug-asanub-gcc/"
      }
    },
    {
      "name": "release-gcc",
      "inherits": ["gcc", "release"],
      "description": "GCC Release Build",
      "binaryDir": "${sourceDir}/build/release-gcc",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "~/Qt/qt6/build/release-gcc/;~/Libs/release-gcc/"
      }
    },

    {
      "name": "debug-clang",
      "inherits": ["clang", "debug"],
      "description": "Clang Debug Build",
      "binaryDir": "${sourceDir}/build/debug-clang",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "~/Qt/qt6/build/debug-clang/;~/Libs/debug-clang/"
      }
    },
    {
      "name": "debug-asanub-clang",
      "inherits": ["debug", "clang"],
      "description": "Clang Release Build",
      "binaryDir": "${sourceDir}/build/debug-asanub-clang",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "~/Qt/qt6/build/debug-asanub-clang/;~/Libs/debug-asanub-clang/"
      }
    },
    {
      "name": "release-clang",
      "inherits": ["clang", "release"],
      "description": "Clang Release Build",
      "binaryDir": "${sourceDir}/build/release-clang",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "~/Qt/qt6/build/release-clang/;~/Libs/release-clang/"
      }
    }
  ]
}
